  "checks": [
    {
      "name": "story.intake",
      "title": "Take the card in: move it to building, say where its progress is",
      "inputs": [
        "card"
      ],
      "outputs": [],
      "formats": {},
      "transient": [],
      "every_run": true,
      "args": []
    },
    {
      "name": "story.take_card_as_story",
      "title": "Take the story an epic's plan wrote on the card (refine is skipped)",
      "inputs": [
        "card"
      ],
      "outputs": [
        "story"
      ],
      "formats": {
        "story": "json"
      },
      "transient": [],
      "every_run": false,
      "args": []
    },
    {
      "name": "story.base",
      "title": "Resolve the commit the story builds on: its base",
      "inputs": [
        "card",
        "repo"
      ],
      "outputs": [
        "base"
      ],
      "formats": {
        "base": "json"
      },
      "transient": [],
      "every_run": false,
      "args": []
    },
    {
      "name": "story.gate",
      "title": "Read the test gate the repository's AGENTS.md names at the base",
      "inputs": [
        "repo",
        "base"
      ],
      "outputs": [
        "gate"
      ],
      "formats": {
        "gate": "json"
      },
      "transient": [],
      "every_run": false,
      "args": []
    },
    {
      "name": "story.agree_plain",
      "title": "Take the split as the agreement, with no proof plan (no meeting)",
      "inputs": [
        "story",
        "layers"
      ],
      "outputs": [
        "agreement"
      ],
      "formats": {
        "agreement": "json"
      },
      "transient": [],
      "every_run": false,
      "args": []
    },
    {
      "name": "story.costed",
      "title": "Record what the stages named (args.stages) cost against their budgets",
      "inputs": [
        "card"
      ],
      "outputs": [],
      "formats": {},
      "transient": [],
      "every_run": true,
      "args": [
        "stages"
      ]
    },
    {
      "name": "story.planned",
      "title": "Mark the story planned (the planning lane's last word)",
      "inputs": [
        "layers"
      ],
      "outputs": [],
      "formats": {},
      "transient": [],
      "every_run": true,
      "args": []
    },
    {
      "name": "story.covered",
      "title": "Find the layer satisfied by the layers below, or else where it is built",
      "inputs": [
        "card",
        "repo",
        "story",
        "layers"
      ],
      "outputs": [
        "satisfied.{item}"
      ],
      "formats": {
        "satisfied.{item}": "json"
      },
      "transient": [],
      "every_run": false,
      "args": []
    },
    {
      "name": "story.ready_package",
      "title": "Ready the layer's package where it is built (interim: Part 2 makes it a model node)",
      "inputs": [
        "card",
        "repo",
        "story",
        "layers"
      ],
      "outputs": [
        "package.{item}",
        "satisfied.{item}"
      ],
      "formats": {
        "package.{item}": "json",
        "satisfied.{item}": "json"
      },
      "transient": [],
      "every_run": false,
      "args": []
    },
    {
      "name": "story.build_once",
      "title": "Build the layer once from its package (interim: Part 2 makes it a write node)",
      "inputs": [
        "card",
        "repo",
        "package.{item}",
        "story",
        "layers"
      ],
      "outputs": [
        "built.{item}"
      ],
      "formats": {
        "built.{item}": "json"
      },
      "transient": [],
      "every_run": false,
      "args": []
    },
    {
      "name": "story.build_done",
      "title": "Finish the build stage once every layer is built or satisfied",
      "inputs": [],
      "outputs": [],
      "formats": {},
      "transient": [],
      "every_run": true,
      "args": []
    },
    {
      "name": "story.publish",
      "title": "Open the layers' stacked draft PRs",
      "inputs": [
        "card",
        "repo",
        "story",
        "layers"
      ],
      "outputs": [
        "prs"
      ],
      "formats": {
        "prs": "list"
      },
      "transient": [],
      "every_run": false,
      "args": []
    },
    {
      "name": "story.finish",
      "title": "Post the PR links, move the card to review, finish the stage",
      "inputs": [
        "card"
      ],
      "outputs": [],
      "formats": {},
      "transient": [],
      "every_run": false,
      "args": []
    },
    {
      "name": "story.refine",
      "title": "Refine the request into a story, as product (interim: Part 2 makes it an ask node)",
      "inputs": [
        "card"
      ],
      "outputs": [
        "story"
      ],
      "formats": {
        "story": "json"
      },
      "transient": [],
      "every_run": false,
      "args": []
    },
    {
      "name": "story.plan_layers",
      "title": "Split the story into layers, as the architect (interim: Part 2 makes it a conversation node)",
      "inputs": [
        "card",
        "repo",
        "story",
        "base",
        "survey"
      ],
      "outputs": [
        "layers"
      ],
      "formats": {
        "layers": "list"
      },
      "transient": [],
      "every_run": false,
      "args": []
    },
    {
      "name": "story.draft_packages",
      "title": "Draft every layer's package in one architect conversation (interim: Part 2 splits it)",
      "inputs": [
        "repo",
        "base",
        "story",
        "layers",
        "agreement"
      ],
      "outputs": [
        "drafted",
        "drafts_session"
      ],
      "formats": {
        "drafted": "bool",
        "drafts_session": "session"
      },
      "transient": [],
      "every_run": false,
      "args": []
    },
    {
      "name": "story.layer_start",
      "title": "Begin a layer: the lines out of it say which of its steps are still to run",
      "inputs": [],
      "outputs": [],
      "formats": {},
      "transient": [],
      "every_run": true,
      "args": []
    },
    {
      "name": "story.request",
      "title": "The card's request as a brief quotes it: its title on one line, its description quoted",
      "inputs": [
        "card"
      ],
      "outputs": [
        "request"
      ],
      "formats": {
        "request": "text"
      },
      "transient": [
        "request"
      ],
      "every_run": false,
      "args": []
    },
    {
      "name": "story.repo_guide",
      "title": "The repository guide to the files the story names, at its base (the layer plan's)",
      "inputs": [
        "repo",
        "story",
        "base"
      ],
      "outputs": [
        "guide"
      ],
      "formats": {
        "guide": "text"
      },
      "transient": [
        "guide"
      ],
      "every_run": false,
      "args": []
    },
    {
      "name": "story.scope_guide",
      "title": "The repository guide to the layers' scope, at the base (the packages' drafting)",
      "inputs": [
        "repo",
        "base",
        "layers"
      ],
      "outputs": [
        "guide"
      ],
      "formats": {
        "guide": "text"
      },
      "transient": [
        "guide"
      ],
      "every_run": false,
      "args": []
    },
    {
      "name": "story.lessons",
      "title": "The repository's recent lessons (size blocks and how they ran)",
      "inputs": [],
      "outputs": [
        "lessons"
      ],
      "formats": {
        "lessons": "list"
      },
      "transient": [
        "lessons"
      ],
      "every_run": false,
      "args": []
    },
    {
      "name": "story.dossier",
