{
  "roles": [
    "aggregator",
    "chief",
    "coder",
    "docs",
    "judge",
    "qa",
    "reviewer",
    "summarizer"
  ],
  "types": [
    "ask",
    "conversation",
    "write",
    "meeting",
    "team",
    "check",
    "gate",
    "bundle"
  ],
  "formats": [
    "json",
    "markdown",
    "text",
    "bool",
    "list",
    "ref:branch",
    "ref:worktree",
    "ref:pr",
    "file",
    "session"
  ],
  "kinds": [
    "text",
    "number",
    "bool",
    "list of \u2026",
    "one of \u2026"
