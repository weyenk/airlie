        "repo",
        "base"
      ],
      "outputs": [
        "dossier"
      ],
      "formats": {
        "dossier": "json"
      },
      "transient": [
        "dossier"
      ],
      "every_run": false,
      "args": []
    },
    {
      "name": "story.coder_budget",
      "title": "The coder's steps and context per layer, what a layer is sized to",
      "inputs": [],
      "outputs": [
        "budget"
      ],
      "formats": {
        "budget": "json"
      },
      "transient": [
        "budget"
      ],
      "every_run": false,
      "args": []
    },
    {
      "name": "story.layer_sources",
      "title": "The files the layer changes, as they are at the base",
      "inputs": [
        "repo",
        "base",
        "layers"
      ],
      "outputs": [
