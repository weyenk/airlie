# The e2e image: the web app's browser tests (tests/e2e) in Playwright's Chromium on Linux. One image for both
# places it runs: Apple's `container` on the Mac (task test:e2e) and the e2e job in GitHub, built from the
# repository root:  container build -f ops/e2e/Containerfile .
#
# The web stage builds the Vue app that the web app serves at /next, on the node major web/package.json pins
# (`engines`); the final stage takes only its build.
FROM node:26-slim AS web
WORKDIR /src
COPY web web
RUN cd web && npm ci && npm run build

# The base carries Chromium and the libraries it needs; its tag is the playwright version uv.lock pins, so
# bump the two together. uv is the same release the lockfile was written with.
FROM mcr.microsoft.com/playwright/python:v1.64.0-noble
COPY --from=ghcr.io/astral-sh/uv:0.6.0 /uv /uvx /usr/local/bin/

# The environment lives outside the source tree, so a checkout mounted over /src can never be written to.
ENV UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    UV_COMPILE_BYTECODE=1 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /src

# Dependencies first, in their own layer: a change to airlie's code does not reinstall them. Torch and its
# CUDA stack (5 GB on Linux) are left out: only the LTS controller's training uses them, and the web app does
# not import it. The rest is exactly uv.lock.
COPY pyproject.toml uv.lock README.md ./
ARG SKIP="torch triton cuda-bindings cuda-pathfinder cuda-toolkit nvidia-cublas nvidia-cuda-cupti \
    nvidia-cuda-nvrtc nvidia-cuda-runtime nvidia-cudnn-cu13 nvidia-cufft nvidia-cufile nvidia-curand \
    nvidia-cusolver nvidia-cusparse nvidia-cusparselt-cu13 nvidia-nccl-cu13 nvidia-nvjitlink nvidia-nvshmem-cu13 \
    nvidia-nvtx"
RUN uv sync --frozen --no-install-project $(printf -- '--no-install-package %s ' $SKIP)

COPY . .
COPY --from=web /src/src/airlie/serve/web_next src/airlie/serve/web_next
RUN uv sync --frozen $(printf -- '--no-install-package %s ' $SKIP)

# Arguments after the image name are pytest's: container run --rm airlie-e2e -k board
ENTRYPOINT ["uv", "run", "--frozen", "--no-sync", "python", "scripts/run_layer.py", "e2e", "-m", "e2e", \
            "--screenshot", "only-on-failure", "--output", "test-results"]
