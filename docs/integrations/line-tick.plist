<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- airlie's line, the belt: every 15 minutes it runs `airlie line tick` through uv (the command `task line:tick`
     wraps), one beat over the planning lane and the build lane. `task serve` runs the same beat every minute while it
     is up; the lane locks make the two safe together. A template: `task line:launchd:install` fills in __AIRLIE_DIR__
     (the checkout) and __HOME__, writes it to ~/Library/LaunchAgents and loads it. It does not run `task`: launchd
     stops a job with SIGTERM, go-task does not pass that signal on, and uv does. The login shell (zsh -l) puts uv and
     gh on PATH, and exec makes uv the process launchd owns, so the SIGTERM reaches it and airlie can stop the story
     and kill gh's process group. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>dev.airlie.line-tick</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>cd "__AIRLIE_DIR__" &amp;&amp; exec uv run --quiet airlie line tick</string>
  </array>
  <key>StartInterval</key><integer>900</integer>
  <key>StandardOutPath</key><string>__HOME__/.local/state/airlie/line-tick.log</string>
  <key>StandardErrorPath</key><string>__HOME__/.local/state/airlie/line-tick.log</string>
</dict>
</plist>
