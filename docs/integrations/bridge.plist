<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Job Bus bridge: keeps `airlie bridge` running (outbound HTTPS to the hub, loopback to task serve).
     `task bridge:launchd:install` fills __AIRLIE_DIR__ and __HOME__, writes ~/Library/LaunchAgents and loads it.
     Requires BRIDGE_WORKER_SECRET in the environment (e.g. ~/.config/airlie/.env read by your login shell). -->
<plist version="1.0">
<dict>
  <key>Label</key><string>dev.airlie.bridge</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>cd "__AIRLIE_DIR__" &amp;&amp; exec uv run --quiet airlie bridge</string>
  </array>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>__HOME__/.local/state/airlie/bridge.log</string>
  <key>StandardErrorPath</key><string>__HOME__/.local/state/airlie/bridge.log</string>
</dict>
</plist>
